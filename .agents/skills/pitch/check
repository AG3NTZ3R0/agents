#!/usr/bin/env bash
# Checks a pitch body against template.md: the same headings and fields in
# the same order, and no placeholder left unfilled.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ $# -ne 1 ] || [ ! -f "$1" ]; then
	echo "usage: check <body-file>" >&2
	exit 2
fi

# A heading, or a bold label at the start of a line, trimmed to the label.
skeleton() { grep -E '^(## |\*\*[^*]+:\*\*)' "$1" | sed -E 's/^(\*\*[^*]+:\*\*).*/\1/'; }

ok=0
if ! diff <(skeleton "$here/template.md") <(skeleton "$1") >&2; then
	echo "headings or fields differ from template.md (< template, > body)" >&2
	ok=1
fi
if grep -n '{{' "$1" >&2; then
	echo "placeholders left unfilled" >&2
	ok=1
fi
[ "$ok" -eq 0 ] && echo "pitch matches template.md"
exit "$ok"
