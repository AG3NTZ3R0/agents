#!/usr/bin/env bash
set -euo pipefail

repo=github/spec-kit

# Ordered as upstream presents the product: what it is, why, its primitives,
# their internals, then the processes an agent runs. docs/toc.yml closes the
# document as the index of everything left out.
paths=(
	docs/index.md
	docs/history.md
	docs/concepts/sdd.md
	spec-driven.md
	docs/reference/overview.md
	docs/reference/core.md
	docs/reference/integrations.md
	docs/reference/extensions.md
	docs/reference/presets.md
	docs/reference/artifacts.md
	docs/reference/workflows.md
	docs/reference/bundles.md
	workflows/ARCHITECTURE.md
	presets/ARCHITECTURE.md
	docs/reference/agentic-sdd.md
	docs/reference/agentic-bugfix.md
	docs/reference/agentic-assessment.md
)
index=docs/toc.yml

installed() { specify version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | awk 'NR==1{print "v" $0}' || true; }

latest=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
was=$(installed)

if [ -z "$was" ]; then
	echo "specify is not installed; see https://github.com/$repo#readme" >&2
else
	if [ "$was" != "$latest" ]; then
		specify self upgrade >&2 || echo "specify self upgrade failed; still on $was" >&2
	fi
	if [ -d .specify ]; then
		specify integration upgrade >&2 || echo "specify integration upgrade failed in $PWD" >&2
		specify extension update >&2 || echo "specify extension update failed in $PWD" >&2
	fi
fi
now=$(installed)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git clone -q --depth 1 --branch "$latest" --filter=blob:none --sparse "https://github.com/$repo" "$tmp/spec-kit" 2>/dev/null
git -C "$tmp/spec-kit" sparse-checkout set --no-cone "${paths[@]/#//}" "/$index"

section() {
	[ -f "$tmp/spec-kit/$1" ] || { echo "missing at $latest: $1" >&2; exit 1; }
	printf '\n===== https://github.com/%s@%s:%s =====\n\n' "$repo" "$latest" "$1"
	cat "$tmp/spec-kit/$1"
}

{
	printf '===== specify: installed %s, now %s, latest %s =====\n' "${was:-none}" "${now:-none}" "$latest"

	for p in "${paths[@]}"; do section "$p"; done

	if [ -n "$was" ] && [ "$was" != "$latest" ]; then
		for t in $(gh api "repos/$repo/releases?per_page=100" --jq '.[] | select(.prerelease | not) | .tag_name'); do
			[ "$t" != "$was" ] && [ "$(printf '%s\n' "$was" "$t" | sort -V | tail -1)" = "$t" ] || continue
			printf '\n===== release notes %s =====\n\n' "$t"
			gh release view "$t" -R "$repo" --json body --jq .body
		done
	fi

	section "$index"
} >"$tmp/doc"

out=$(mktemp "${TMPDIR:-/tmp}/speckit-$latest.XXXXXX.md")
mv "$tmp/doc" "$out"
echo "$out"
