#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo=github/spec-kit
root="${XDG_CACHE_HOME:-$HOME/.cache}/speckit"

installed() { specify version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | awk 'NR==1{print "v" $0}' || true; }

latest=$(gh api "repos/$repo/releases/latest" --jq .tag_name)
was=$(installed)

if [ -z "$was" ]; then
	echo "specify is not installed; see https://github.com/$repo#readme" >&2
else
	if [ "$was" != "$latest" ]; then
		specify self upgrade >&2 || echo "specify self upgrade failed; still on $was" >&2
	fi
	if [ -d .specify ]; then
		# Replaces managed templates, commands, and scripts with the release's,
		# only when the release that last wrote them is not the installed one,
		# since every upgrade rewrites the manifest's install time.
		integration=$(grep -oE '"(default_)?integration": "[^"]+"' .specify/integration.json 2>/dev/null | tail -1 | cut -d'"' -f4) || true
		project=$(grep -oE '"version": "[^"]+"' ".specify/integrations/$integration.manifest.json" 2>/dev/null | head -1 | cut -d'"' -f4) || true
		if [ "v$project" != "$(installed)" ]; then
			specify integration upgrade --force >&2 || echo "specify integration upgrade failed in $PWD" >&2
		fi
		specify extension update >&2 || echo "specify extension update failed in $PWD" >&2
		# Adds each bundled extension the project lacks.
		bundled=$("$here/bundled") || echo "could not list bundled extensions; none were added in $PWD" >&2
		have=$(specify extension list --json | grep -oE '"id": "[^"]+"' | cut -d'"' -f4) ||
			echo "specify extension list failed in $PWD" >&2
		for e in ${bundled:-}; do
			grep -qxF "$e" <<<"$have" && continue
			specify extension add "$e" >&2 || echo "specify extension add $e failed in $PWD" >&2
		done
		specify workflow update >&2 || echo "specify workflow update failed in $PWD" >&2
		# Adds each bundled workflow the project lacks.
		bundled=$("$here/bundled" workflows) || echo "could not list bundled workflows; none were added in $PWD" >&2
		have=$(specify workflow list | grep -oE '\([a-z0-9-]+\) v' | tr -d '() v') ||
			echo "specify workflow list failed in $PWD" >&2
		for w in ${bundled:-}; do
			grep -qxF "$w" <<<"$have" && continue
			specify workflow add "$w" >&2 || echo "specify workflow add $w failed in $PWD" >&2
		done
		# Adds each workflow in the agents clone's specify/workflows/, and re-adds
		# one whose installed copy differs from it, since `specify workflow update`
		# skips workflows installed from a local path.
		clone="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
		for src in "$clone"/specify/workflows/*/; do
			[ -f "$src/workflow.yml" ] || continue
			w=$(grep -m1 -oE '^  id: *"?[a-z0-9-]+' "$src/workflow.yml" | grep -oE '[a-z0-9-]+$')
			[ -n "$w" ] || { echo "no workflow id in $src/workflow.yml" >&2; continue; }
			if [ -d ".specify/workflows/$w" ]; then
				diff -rq "$src" ".specify/workflows/$w" >/dev/null && continue
				specify workflow remove "$w" >&2 || { echo "specify workflow remove $w failed in $PWD" >&2; continue; }
			fi
			specify workflow add --dev "$src" >&2 || echo "specify workflow add --dev $src failed in $PWD" >&2
		done
	fi
fi
now=$(installed)

# A release never changes, so its docs are cached under its tag and every
# other tag is dropped.
cache="$root/$latest"
if [ ! -f "$cache/docs/toc.yml" ]; then
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	git clone -q --depth 1 --branch "$latest" --filter=blob:none --sparse "https://github.com/$repo" "$tmp/spec-kit" 2>/dev/null
	git -C "$tmp/spec-kit" sparse-checkout set --no-cone /docs/ /spec-driven.md
	rm -rf "$tmp/spec-kit/.git" "$root"
	mkdir -p "$root"
	mv "$tmp/spec-kit" "$cache"
fi

printf 'specify: installed %s, now %s, latest %s\n' "${was:-none}" "${now:-none}" "$latest"
printf 'docs: %s\n' "$cache"

if [ -n "$was" ] && [ "$was" != "$latest" ]; then
	for t in $(gh api "repos/$repo/releases?per_page=100" --jq '.[] | select(.prerelease | not) | .tag_name'); do
		[ "$t" != "$was" ] && [ "$(printf '%s\n' "$was" "$t" | sort -V | tail -1)" = "$t" ] || continue
		printf '\n===== release notes %s =====\n\n' "$t"
		gh release view "$t" -R "$repo" --json body --jq .body
	done
fi

printf '\n===== docs/toc.yml =====\n\n'
cat "$cache/docs/toc.yml"
