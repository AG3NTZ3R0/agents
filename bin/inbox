#!/usr/bin/env bash
# Lists the guarded-sdd runs that need you in every worktree of this Spec Kit
# project, and opens an interactive Claude session in the worktree of the one
# you pick: to resolve a failed or paused run so it can resume, or to review a
# completed run's code.
set -euo pipefail

[ -d .specify ] || { echo "not a Spec Kit project: no .specify/ here" >&2; exit 2; }

dirs=() runs=()
while IFS= read -r dir; do
	[ -d "$dir/.specify" ] || continue
	while IFS= read -r id; do
		dirs+=("$dir")
		runs+=("$id")
	done < <(cd "$dir" && specify workflow status --json |
		jq -r '.runs[] | select(.workflow_id == "guarded-sdd")
			| select(.status == "paused" or .status == "failed" or .status == "completed")
			| .run_id')
done < <(git worktree list --porcelain | sed -n 's/^worktree //p')

if [ "${#runs[@]}" -eq 0 ]; then
	echo "no guarded-sdd runs need you"
	exit 0
fi

state() { cat "$1/.specify/workflows/runs/$2/state.json"; }

for i in "${!runs[@]}"; do
	state "${dirs[$i]}" "${runs[$i]}" | jq -r --arg n "$((i + 1))" --arg dir "${dirs[$i]}" \
		'"\($n)) \(.run_id)  \(.status) at \(.current_step_id // "-")  \($dir)"'
done

read -rp "open which? " n
[[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#runs[@]}" ] ||
	{ echo "no such run: $n" >&2; exit 2; }
dir="${dirs[$((n - 1))]}"
id="${runs[$((n - 1))]}"
status=$(state "$dir" "$id" | jq -r .status)

if [ "$status" = completed ]; then
	ask="It finished, so review the code it wrote: walk me through what changed against the feature spec and answer my questions. Do not commit, push, or open a review unless I ask."
else
	ask="Rerun that check to see what it found, walk me through resolving it, and tell me when the run is ready for \`specify workflow resume $id\`."
fi

prompt="$(state "$dir" "$id" | jq -r \
	'"Spec Kit workflow run \(.run_id) (\(.workflow_id)) is \(.status) at step \(.current_step_id // "-")."')

This is a Guarded SDD run: each check-speckit-* step stops the run when the step before it left work for a human.

$ask"

(cd "$dir" && claude "$prompt")

echo "run $id is in $dir"
[ "$status" = completed ] || echo "resume with: cd $dir && specify workflow resume $id"
