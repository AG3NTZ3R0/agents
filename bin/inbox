#!/usr/bin/env bash
# Lists the handoff runs that need you in every worktree of this project, and
# opens an interactive Claude session in the worktree of the one you pick: to
# resolve a failed or paused run so it can resume, or to review a completed
# run's code.
set -euo pipefail

git rev-parse --git-dir >/dev/null

dirs=() runs=()
while IFS= read -r dir; do
	[ -d "$dir/.specify/workflows/runs" ] || continue
	while IFS= read -r id; do
		dirs+=("$dir")
		runs+=("$id")
	done < <(cd "$dir" && specify workflow status --json |
		jq -r '.runs[] | select(.workflow_id == "guarded-sdd" or .workflow_id == "task")
			| select(.status == "paused" or .status == "failed" or .status == "completed")
			| .run_id')
done < <(git worktree list --porcelain | sed -n 's/^worktree //p')

if [ "${#runs[@]}" -eq 0 ]; then
	echo "no handoff runs need you"
	exit 0
fi

state() { cat "$1/.specify/workflows/runs/$2/state.json"; }

# The branch names the work; a guarded-sdd run stopped before specify has none yet.
for i in "${!runs[@]}"; do
	branch=$(git -C "${dirs[$i]}" branch --show-current)
	state "${dirs[$i]}" "${runs[$i]}" | jq -r --arg n "$((i + 1))" --arg branch "${branch:-(no branch yet)}" \
		'"\($n))\t\($branch)\t\(.workflow_id)\t\(.status) at \(.current_step_id // "-")\t(\(.run_id))"'
done | column -t -s $'\t'

read -rp "open which? " n
[[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#runs[@]}" ] ||
	{ echo "no such run: $n" >&2; exit 2; }
dir="${dirs[$((n - 1))]}"
id="${runs[$((n - 1))]}"
status=$(state "$dir" "$id" | jq -r .status)
workflow=$(state "$dir" "$id" | jq -r .workflow_id)

if [ "$workflow" = task ]; then
	about="This is a Task run: one headless session built the task, and check-build stops the run when it left questions in .specify/questions.md or uncommitted changes."
	against="the task"
	ready="delete .specify/questions.md once its questions are answered, and tell me when the run is ready for \`specify workflow resume $id\`"
else
	about="This is a Guarded SDD run: each check-speckit-* step stops the run when the step before it left work for a human."
	against="the feature spec"
	ready="tell me when the run is ready for \`specify workflow resume $id\`"
fi

if [ "$status" = completed ]; then
	ask="It finished, so review the code it wrote: walk me through what changed against $against and answer my questions. Do not commit, push, or open a review unless I ask."
else
	ask="Rerun that check to see what it found, walk me through resolving it, $ready."
fi

prompt="$(state "$dir" "$id" | jq -r \
	'"Spec Kit workflow run \(.run_id) (\(.workflow_id)) is \(.status) at step \(.current_step_id // "-")."')

$about

$ask"

(cd "$dir" && claude "$prompt")

echo "run $id is in $dir"
[ "$status" = completed ] || echo "resume with: cd $dir && specify workflow resume $id"
