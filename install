#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

link() {
	local src="$1" dst="$2"

	if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
		echo "already linked: $dst -> $src"
		return
	fi

	# A link to nothing is left over from a moved clone, so it is replaced.
	if [ -L "$dst" ] && [ ! -e "$dst" ]; then
		rm "$dst"
	elif [ -e "$dst" ] || [ -L "$dst" ]; then
		echo "refusing to replace $dst" >&2
		exit 1
	fi

	mkdir -p "$(dirname "$dst")"
	ln -s "$src" "$dst"
	echo "linked: $dst -> $src"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md"

for skill in "$here"/.agents/skills/*/; do
	link "${skill%/}" "$HOME/.claude/skills/$(basename "$skill")"
done

# Claude Code records the plugin in its own settings and keeps it updated.
# --marketplace adds the official marketplace before the first session does.
if command -v claude >/dev/null; then
	claude plugin install aws-core --marketplace anthropics/claude-plugins-official
else
	echo "warning: claude is not on PATH, so the aws-core plugin is not installed." >&2
fi

# Claude Code writes ~/.claude/settings.json too, so this repo's settings are
# merged in: a list gains what it lacks, and a value already set is kept.
settings="$HOME/.claude/settings.json"
[ -e "$settings" ] || echo '{}' >"$settings"
merged="$(jq -s '
	def merge($a; $b):
		if ($a | type) == "object" and ($b | type) == "object" then
			reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
		elif ($a | type) == "array" and ($b | type) == "array" then $a + ($b - $a)
		elif $a == null then $b
		else $a end;
	merge(.[0]; .[1])' "$settings" "$here/claude/settings.json")"
if [ "$merged" = "$(jq . "$settings")" ]; then
	echo "already merged: $settings"
else
	printf '%s\n' "$merged" >"$settings"
	echo "merged: $here/claude/settings.json into $settings"
fi

link "$here/vim/vimrc" "$HOME/.vim/vimrc"

# Vim reads ~/.vimrc before ~/.vim/vimrc (:help vimrc), so the user decides.
if [ -e "$HOME/.vimrc" ]; then
	echo "warning: ~/.vimrc exists, so Vim ignores ~/.vim/vimrc." >&2
	echo "  To use this repo's vimrc, move your settings into" >&2
	echo "  $here/vim/vimrc and remove ~/.vimrc." >&2
	echo "  To keep yours, do nothing." >&2
fi

# Git's own include keeps ~/.gitconfig the user's, with one line pointing here.
if git config --global --get-all include.path | grep -qxF "$here/git/gitconfig"; then
	echo "already included: $here/git/gitconfig"
else
	git config --global --add include.path "$here/git/gitconfig"
	echo "included: $here/git/gitconfig"
fi

# A link into this clone to a skill or script that no longer exists is removed.
for dst in "$HOME"/.claude/skills/* "$HOME"/.local/bin/*; do
	if [ -L "$dst" ] && [ ! -e "$dst" ] &&
		[[ "$(readlink "$dst")" == "$here/.agents/skills/"* || "$(readlink "$dst")" == "$here/bin/"* ]]; then
		rm "$dst"
		echo "removed: $dst"
	fi
done
