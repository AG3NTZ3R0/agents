#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

link() {
	local src="$1" dst="$2"

	if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
		echo "already linked: $dst -> $src"
		return
	fi

	# A link to nothing is left over from a moved clone, so it is replaced.
	if [ -L "$dst" ] && [ ! -e "$dst" ]; then
		rm "$dst"
	elif [ -e "$dst" ] || [ -L "$dst" ]; then
		echo "refusing to replace $dst" >&2
		exit 1
	fi

	mkdir -p "$(dirname "$dst")"
	ln -s "$src" "$dst"
	echo "linked: $dst -> $src"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md"

for skill in "$here"/.agents/skills/*/; do
	link "${skill%/}" "$HOME/.claude/skills/$(basename "$skill")"
done

# A link into this clone to a skill that no longer exists is removed.
for dst in "$HOME"/.claude/skills/*; do
	if [ -L "$dst" ] && [ ! -e "$dst" ] && [[ "$(readlink "$dst")" == "$here/.agents/skills/"* ]]; then
		rm "$dst"
		echo "removed: $dst"
	fi
done
