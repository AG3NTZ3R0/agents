#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

link() {
	local src="$1" dst="$2"

	if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
		echo "already linked: $dst -> $src"
		return
	fi

	if [ -e "$dst" ] || [ -L "$dst" ]; then
		echo "refusing to replace $dst" >&2
		exit 1
	fi

	mkdir -p "$(dirname "$dst")"
	ln -s "$src" "$dst"
	echo "linked: $dst -> $src"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md"

# A skill linked into this repository's .claude/skills/ maintains this
# repository alone, so it is not installed.
for skill in "$here"/.agents/skills/*/; do
	name="$(basename "$skill")"
	[ -e "$here/.claude/skills/$name" ] && continue
	link "${skill%/}" "$HOME/.claude/skills/$name"
done
